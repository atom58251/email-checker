# Публичные переменные — их можно смело коммитить в .env.example (но не в .env!)
# Значения берутся из Supabase Dashboard -> Project Settings -> API.
# anon key безопасен для фронтенда: реальная защита данных — на RLS в базе.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# service_role key НИКОГДА не добавляется сюда и не используется в web/ —
# он существует только как секрет внутри Supabase Edge Functions
# (задаётся через `supabase secrets set`, см. README.md).
